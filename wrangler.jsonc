{
  // MUST stay "digital-home-frontend-starter": that is the Worker actually
  // serving the live site, and it is the name the backend's FRONTEND_WORKER
  // service binding resolves by. Deploying under any other name silently
  // creates a second, empty Worker instead of updating the real one.
  "name": "digital-home-frontend-starter",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Custom domain. envisioned.me is already on Cloudflare nameservers, so
  // wrangler provisions the DNS record and certificate on deploy. This is a
  // SUBDOMAIN on purpose: the apex envisioned.me keeps serving the existing
  // site untouched, and a subdomain needs no Next.js basePath (a /path mount
  // would break every asset and internal link).
  // CANONICAL IS www.envisioned.me (2026-08-27). The bare apex route was
  // accepted by wrangler but never actually took effect — the apex kept
  // serving the old WP Engine install while www served this Worker, with
  // identical route config. Rather than leave the sitemap advertising a
  // hostname that returns a 2024 membership site, canonical moved to www,
  // which demonstrably works. The apex route stays declared below so it
  // starts working the moment whatever is blocking it is cleared; flipping
  // canonical back is then a one-line change.
  //
  // Original note: envisioned.me is the intended canonical home (2026-08-27). The apex was still
  // pointing at an abandoned WP Engine install (default demo content, last
  // touched Aug 2024) that described a membership business she no longer runs
  // — so the strongest domain was telling search engines and LLMs the wrong
  // thing while the real site sat on a subdomain nothing linked to.
  //
  // These are ZONE ROUTES, not custom domains: the hostname is already proxied
  // through Cloudflare, so the Worker simply runs in front of the old origin.
  // No DNS was changed, and deleting these two lines puts WordPress back.
  "routes": [
    { "pattern": "envisioned.me/*", "zone_name": "envisioned.me" },
    { "pattern": "www.envisioned.me/*", "zone_name": "envisioned.me" },
    { "pattern": "home.envisioned.me", "custom_domain": true }
  ],
  // Cloudflare's native rate limiters. Free, edge-local, no KV or Durable Object
  // needed. Two tiers: WRITE_LIMITER guards the high-volume anonymous writes
  // (lead capture, visitor + analytics beacons); STRICT_LIMITER guards the ones
  // that cost real money or real time if abused — bookings, the assessment, and
  // anything that sends mail. namespace_id just has to be unique and stable.
  // Audit finding, 2026-08-18.
  "unsafe": {
    "bindings": [
      {
        "name": "WRITE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "STRICT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  },

  // Runtime duplicates of NEXT_PUBLIC_ vars — Workers can't read NEXT_PUBLIC_ at runtime
  "vars": {
    "SUPABASE_URL": "https://aqylffhuzunpimrebgye.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_JumdNZ3GzN06G5oVgBR8_Q_SX8vdlbq",
    "NEXT_PUBLIC_SUPABASE_URL": "https://aqylffhuzunpimrebgye.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_JumdNZ3GzN06G5oVgBR8_Q_SX8vdlbq",
    "NEXT_PUBLIC_SITE_NAME": "Envisioned",
    "SITE_URL": "https://www.envisioned.me",
    "NEXT_PUBLIC_SITE_URL": "https://www.envisioned.me",
    "CRM_BACKEND_URL": "https://app.envisioned.me"
  }
}
